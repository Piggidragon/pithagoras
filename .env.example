# The portal can run arbitrary commands, so lock it down. Without a password it
# refuses to start, so a typo here cannot leave the port open by accident.
PORTAL_PASSWORD=change-me
# Set this to 1 to run with no login at all, which is only safe when a reverse
# proxy with its own login sits in front and nothing else can reach the port.
# PORTAL_ALLOW_NO_PASSWORD=1
# Keeps sessions valid across restarts: openssl rand -hex 32
PORTAL_SECRET=

# Where your workspaces live on the host
WORKSPACES_DIR=/root/repos

# Where the portal keeps its data (database, pi settings, sessions). Leave it
# out for a Docker volume, or give an absolute host path to keep it in a folder:
# PORTAL_DATA_DIR=/home/you/.local/share/pithagoras/data
# Keep it apart from WORKSPACES_DIR: that folder is where sessions work, and the
# portal's own database should not sit among the projects.

# host = pi runs inside the portal container (fast, full access to mounted repos)
# container = one isolated container per task (needs the docker socket mount)
EXECUTOR=host

# Overrides only. Leave empty to inherit pi's settings.json.
PI_PROVIDER=
PI_MODEL=
PI_THINKING_LEVEL=

# Container executor only; positive limits are required (zero is rejected).
PI_IMAGE=pithagoras-runner:latest
TASK_MEMORY_MB=2048
TASK_CPUS=2
TASK_PIDS_LIMIT=512
OPENROUTER_API_KEY=

# A local llama.cpp server or llama-swap gateway, if you run one. Reachable from
# inside the container at the same address as on the host, because the container
# shares its network. Behind llama-swap, register it in pi's models.json rather
# than through pi-llama-cpp: see docs/guide/voice.md#behind-llama-swap.
LLAMA_BASE_URL=http://127.0.0.1:8080

# The agent's browser is installed from the portal (Browser → Install), not from
# here — it needs no configuration in this file.
