[Unit]
Description=Pithagoras Breeze-TTS-2 speech synthesis
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/breeze/breeze-tts
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_OFFLINE=1
Environment=PYTORCH_ALLOC_CONF=expandable_segments:True
ExecStart=/root/breeze/breeze-tts/.venv/bin/python -m breeze_infer.api /root/breeze/breeze-tts-2 --host 127.0.0.1 --port 7860
Restart=no
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
