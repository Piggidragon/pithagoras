[Unit]
Description=Pithagoras Whisper speech recognition
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pithagoras/voice-runtime/whisper.cpp
ExecStart=/opt/pithagoras/voice-runtime/whisper.cpp/build/bin/whisper-server --host 127.0.0.1 --port 8178 --model /opt/pithagoras/voice-runtime/whisper.cpp/models/ggml-base.bin --language auto --threads 4
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
