[Unit]
Description=Pithagoras multilingual speech (Chatterbox TTS + Qwen3-ASR, audio.cpp)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/audio.cpp
# Pin the speech models to one GPU, leaving the other for the session model.
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/opt/audio.cpp/build/linux-cuda-release/bin/audiocpp_server --config /opt/pithagoras/deploy/voice-multilingual/server.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
